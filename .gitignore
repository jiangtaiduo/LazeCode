# Internal audit reports (not part of the public repo; kept locally/separate)
.audit/

# Local reference screenshots (not part of the public repo)
/screenshots/

# The vendored VT static library IS tracked (macOS arm64) so that a fresh
# clone builds with zero configuration on the verified target. Other targets
# build their own and point GHOSTTY_VT_LIB_DIR at it — see README "Building".
# To stop tracking it in your own fork:
#   git rm --cached src-tauri/vendor/ghostty-vt/lib/libghostty-vt.a
#   printf '%s\n' 'libghostty-vt.a' >> src-tauri/vendor/ghostty-vt/lib/.gitignore

# Local Tauri build output
src-tauri/gen/

# Updater private signing keys
*.key
src-tauri/*.key

